# GEMINI_API_KEY: Required for Google Gemini API calls
GEMINI_API_KEY=

# Google Programmable Search Engine API (Optional: Real-time Web Search Grounding)
# GOOGLE_SEARCH_API_KEY: Google Cloud Console API Key with Custom Search API enabled
GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX: Programmable Search Engine ID (from programmablesearchengine.google.com)
GOOGLE_SEARCH_CX=

# Cloud Text-to-Speech API (Google Cloud TTS / Neural Tamil voices)
GOOGLE_TTS_API_KEY=
AZURE_TTS_KEY=

# NVIDIA NIM API Keys
NVIDIA_API_KEY=
NVIDIA_API_KEY_GLM=
NVIDIA_API_KEY_NEMOTRON=
NVIDIA_API_KEY_INKLING=
NVIDIA_API_KEY_DEEPSEEK=
NVIDIA_API_KEY_IMAGEGEN=

# Server Hosting & Binding (Defaults to 127.0.0.1 for security)
HOST=127.0.0.1

# Terminal & Filesystem Authentication
TERMINAL_AUTH_TOKEN=

# APP_URL: Hosted App URL
APP_URL=
